# Base URL of the Inference API. Leave unset to use the Vite dev proxy
# (vite.config.ts forwards /api to http://localhost:8080).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Where the anonymous page-view beacon posts. Leave unset for a same-origin API.
# The static demo has no API behind it, so it needs an absolute URL:
#   VITE_ANALYTICS_ENDPOINT=https://api.your-domain.example/api/_analytics/page-view
#
# This value is compiled into the public bundle. That is fine — it is just a URL.
# NEVER put the Postgres connection string in a VITE_ variable; it belongs only
# in the server's ANALYTICS_DATABASE_URL.
VITE_ANALYTICS_ENDPOINT=
