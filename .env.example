PORT=8080
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/inference

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace-with-a-different-32-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-key
S3_BUCKET_NAME=replace-with-private-bucket
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/inference-resume-queue
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/inference-resume-dlq

OPENAI_API_KEY=replace-with-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_ID=gpt-4o-mini

# Comma-separated allowlist. Include the demo's origin if you want its
# page views recorded.
CLIENT_ORIGIN=https://your-frontend-origin.example,https://your-demo.pages.dev

# Anonymous page-view analytics (optional). Server-side only — this string is
# never sent to the browser. Leave blank to disable page-view recording.
ANALYTICS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ANALYTICS_PROJECT_NAME=inference
